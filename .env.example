# OmniFlow V1 — environment variables
#
# This file only lists what the NEW build (docs/specification/, Phase 1+)
# actually needs at each stage. It intentionally does NOT include the old
# product's variables (Paddle, NOWPayments, Kling, Apify, N8N, Telegram) —
# those belong to features out of V1 scope (see docs/implementation/TECH_DEBT.md).
#
# Copy this file to .env.local for local development. Never commit .env.local.

# ── Supabase (required from Phase 1) ────────────────────────────────────────
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the frontend. Bypasses RLS — used only in
# trusted server code (e.g. the signup trigger's underlying service calls).
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI provider (needed starting Phase 7 — AI Gateway) ──────────────────────
# console.anthropic.com. Server-only, used exclusively by the AI Gateway
# (docs/specification/OmniFlow_05_AI_Model_Router.md) — never called directly
# from feature code.
ANTHROPIC_API_KEY=
# Optional. Overrides the Fast-tier model used by the AI Gateway's Model
# Registry (src/lib/ai/gateway.ts). Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL_FAST=

# ── Billing (needed starting Phase 13) ──────────────────────────────────────
# Provider not yet chosen for the new Copilot/Full AI + 2.5% commission model
# (see docs/implementation/OPEN_QUESTIONS.md). Placeholder section — filled
# in when Phase 13 starts.
